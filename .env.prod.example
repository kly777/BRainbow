# ── 生产环境配置模板 ──
# 复制为 .env.prod 使用（make deploy 读取）
# 前端: vite build --mode prod 读取（vite.config.ts 的 loadEnv 指向项目根）
# 后端: deploy.sh 读取并注入 systemd 服务
# 部署: deploy.sh 读取远程连接与备份配置

# ── 前端构建（vite --mode prod） ──
VITE_SITE_URL=https://example.com

# ── 站点域名（Caddy 配置渲染用） ──
DOMAIN="example.com"

# ── 后端（deploy.sh → systemd Environment） ──
SERVICE_PORT="8080"
BIND_HOST="0.0.0.0"
DATABASE_URL="sqlite:/opt/brb/data/brainbow.db"
CORS_ALLOW_ORIGIN="https://example.com,http://example.com"

# ── 部署（deploy.sh） ──
REMOTE_HOST="your-server-ip-or-domain.com"
REMOTE_USER="your-user"
REMOTE_BASE="/opt"
APP_NAME="brb"
REMOTE_PORT=22

# 构建目标:
#   native          — 本地架构（默认）
#   x86_64-unknown-linux-gnu — Linux x86_64 交叉编译
#BUILD_TARGET=native

# 是否开放注册（公网部署建议保持 false，需要时手动开）
ALLOW_REGISTER=false
