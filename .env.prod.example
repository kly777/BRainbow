# ── 生产环境配置模板 ──
# 复制为 .env.prod 使用（just deploy / cargo xtask deploy 读取）
# 前端: vite build --mode prod 读取（vite.config.ts 的 loadEnv 指向项目根）
# 后端: xtask 渲染 systemd unit 时把这些值写进 Environment=
# 部署: xtask 读取远程连接、备份与构建目标配置

# ── 前端构建（vite --mode prod） ──
VITE_SITE_URL=https://example.com

# ── 站点域名（Caddy 配置渲染用） ──
DOMAIN="example.com"

# ── 后端（xtask 渲染 systemd unit 时注入 Environment） ──
SERVICE_PORT="8080"
BIND_HOST="0.0.0.0"

# ── 数据位置：只用「根目录 + 约定」，不用在这里写绝对路径 ──
# 根目录 = {REMOTE_BASE}/{APP_NAME}（见下面的部署段），约定如下：
#   数据目录 = {根}/data
#   数据库   = {数据目录}/{DATABASE_FILE}（默认 brainbow.db）
#   上传根   = {数据目录}/uploads（文件服务在它的 file/ 下，favicon 在 favicons/ 下）
#   备份目录 = {根}/backup（应用只读它来报"备份多少份、占多大"，见 /admin）
# 改根目录时这一整套跟着走，不会出现"改了三处漏一处、数据写到别处"的情况。
# 想单独覆盖某一项就显式写出来（显式的永远优先，逃生口一直在）：
#DATABASE_URL="sqlite:/opt/brb/data/brainbow.db"
#UPLOAD_DIR="/opt/brb/data/uploads"
#BACKUP_DIR="/opt/brb/backup"
CORS_ALLOW_ORIGIN="https://example.com,http://example.com"

# ── 部署（xtask） ──
REMOTE_HOST="your-server-ip-or-domain.com"
REMOTE_USER="your-user"
REMOTE_BASE="/opt"
APP_NAME="brb"
REMOTE_PORT=22

# 构建目标:
#   x86_64-unknown-linux-musl — **推荐**：完全静态，不依赖服务器 glibc
#   native                    — 本机架构（会绑定构建机的 glibc 版本，见下）
#   x86_64-unknown-linux-gnu  — Linux x86_64 交叉编译（同样绑定构建机 glibc）
#
# 为什么推荐 musl：构建机与服务器常常不是同一个发行版，而 glibc 的符号版本只会
# 随构建机走。实测：WSL（Ubuntu 24.04 / glibc 2.39）构建的产物，在 Ubuntu 22.04
# （glibc 2.35）服务器上「加载即失败」：
#   version `GLIBC_2.39' not found (required by /opt/brb/service/brainbow)
# 原因是 Rust 的 std::process::Command 在 glibc ≥ 2.39 上会绑定新增的
# pidfd_spawnp。musl 静态产物没有 glibc 符号，这类问题从根上没有了。
# 前置：sudo apt install musl-tools && rustup target add x86_64-unknown-linux-musl
# （继续用 native 也行，但 just check / just deploy 会在部署前拦下不兼容的产物）
BUILD_TARGET=x86_64-unknown-linux-musl

# 是否开放注册（公网部署建议保持 false，需要时手动开；由 systemd 注入生效）
ALLOW_REGISTER=false

# JWT 有效期（秒），默认 864000 = 10 天；由 systemd 注入生效
JWT_TTL_SECS=864000
