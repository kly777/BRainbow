  "query": "SELECT n.id AS node_id, t.id AS tree_id, t.title, n.content\n               FROM chat_node n JOIN chat_tree t ON t.id = n.tree_id\n               WHERE (?1 IS NULL OR t.user_id = ?1) AND n.content LIKE ?2 ESCAPE '\\'\n               ORDER BY n.id DESC LIMIT ?3",
