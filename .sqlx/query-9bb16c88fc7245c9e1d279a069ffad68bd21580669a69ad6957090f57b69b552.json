  "query": "SELECT id AS tree_id, title AS tree_title,\n                          COALESCE(updated_at, CURRENT_TIMESTAMP) AS \"updated_at!: String\"\n                   FROM chat_tree\n                   WHERE (?1 IS NULL OR user_id = ?1) AND title LIKE ?2 ESCAPE '\\'\n                   ORDER BY updated_at DESC LIMIT ?3",
