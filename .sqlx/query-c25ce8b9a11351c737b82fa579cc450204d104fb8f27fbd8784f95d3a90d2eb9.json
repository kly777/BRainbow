  "query": "SELECT t.id AS \"id: i32\", t.name, COUNT(r.bookmark_id) AS \"count!: i64\"\n                   FROM bookmark_tag t\n                   LEFT JOIN bookmark_tag_rel r ON r.tag_id = t.id\n                   WHERE t.name LIKE ? ESCAPE '\\'\n                   GROUP BY t.id, t.name\n                   ORDER BY COUNT(r.bookmark_id) DESC, t.name",
