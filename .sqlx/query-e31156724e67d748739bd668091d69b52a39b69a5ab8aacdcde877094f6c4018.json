  "query": "SELECT t.id, t.title, t.description,\n                      0 AS \"title_hit!: i64\"\n               FROM task_fts fts\n               JOIN task t ON t.id = fts.rowid\n               WHERE task_fts MATCH ?2\n                 AND (?1 IS NULL OR t.user_id = ?1)\n               ORDER BY rank\n               LIMIT ?3",
