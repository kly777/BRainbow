# Caddy 配置模板（占位符由 xtask 的 render 用 .env.prod 渲染后同步到远端；
# 想先看渲染结果：`cargo xtask render caddy`）

@@DOMAIN@@ {
	encode gzip zstd

	# ── 安全响应头（site 级，覆盖所有响应） ──
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# 仅允许同源 iframe 嵌入：跨站 clickjacking 仍被拒，同时让详情页的 PDF
		# 预览（同源 <iframe>）能正常渲染 —— DENY 会连自己人也拦，
		# Firefox 报 "will not allow Firefox to display the page if another site has embedded it"
		X-Frame-Options "SAMEORIGIN"
		# 弹窗隔离（reverse tabnabbing）
		Cross-Origin-Opener-Policy "same-origin"
		# MIME 嗅探防护
		X-Content-Type-Options "nosniff"
		# 引用来源最小化
		Referrer-Policy "strict-origin-when-cross-origin"
		# XSS 防线：白名单管控加载来源
		# - 'unsafe-inline'：index.html 内联错误处理脚本 + 内联 style
		# - 'unsafe-eval'：CF Rocket Loader 所需（关闭 Rocket Loader 后可移除）
		# - static.cloudflareinsights.com：CF Web Analytics beacon
		# - img https:：Markdown 可能引用外部图片
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
	}

	# API 反代到后端。/uploads/* 不再代理：后端无此路由（唯一文件路由是
	# /api/media/{id}/file），原配置只会让 axum fallback 返回 SPA HTML 被
	# CF 按扩展名缓存（审计 D11）
	@backend path /api/*
	handle @backend {
		reverse_proxy localhost:@@SERVICE_PORT@@
	}

	# hash 文件名资源：缺失直接 404（绝不 fallback 成 HTML，否则会被缓存成错误 MIME）
	handle /assets/* {
		root * @@DIST_DIR@@
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# RFC 9727 API Catalog（无扩展名文件需显式 Content-Type）
	handle /.well-known/api-catalog {
		root * @@DIST_DIR@@
		header Content-Type "application/linkset+json"
		header Cache-Control "no-cache"
		file_server
	}

	# ── Markdown for Agents：Accept: text/markdown 协商（dist/_md/<path>.md） ──
	@md-home {
		header Accept *text/markdown*
		path /
	}
	handle @md-home {
		root * @@DIST_DIR@@
		rewrite * /_md/index.md
		header Content-Type "text/markdown; charset=utf-8"
		header Cache-Control "no-cache"
		header Vary Accept
		file_server
	}
	@md-page {
		header Accept *text/markdown*
		path /*
	}
	handle @md-page {
		root * @@DIST_DIR@@
		@mdfile file /_md{path}.md
		handle @mdfile {
			rewrite * /_md{path}.md
			header Content-Type "text/markdown; charset=utf-8"
			header Cache-Control "no-cache"
			header Vary Accept
			file_server
		}
		# 动态路由无预生成 .md：回落 SPA（审计 E7，不再裸 404）
		handle {
			try_files {path} /index.html
			file_server
			header Cache-Control "no-cache"
		}
	}

	# SPA：非 asset 路径统一 no-cache（防 CF 缓存旧 index.html）
	handle {
		root * @@DIST_DIR@@
		try_files {path} /index.html
		file_server
		header Cache-Control "no-cache"
	}
}
