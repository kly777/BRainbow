[Unit]
Description=Brainbow Application
After=network.target

[Service]
Type=simple
User=@@REMOTE_USER@@
WorkingDirectory=@@SERVICE_DIR@@
ExecStart=@@SERVICE_DIR@@/brainbow
Restart=on-failure
RestartSec=5
# 优雅关闭超时：SSE/keep-alive 连接可能卡住 graceful shutdown，15 秒后强制终止
TimeoutStopSec=15
MemoryMax=1024M
CPUQuota=80%
Environment="RUST_LOG=info"
Environment="SERVICE_PORT=@@SERVICE_PORT@@"
Environment="BIND_HOST=@@BIND_HOST@@"
Environment="DATABASE_URL=@@DATABASE_URL@@"
Environment="UPLOAD_DIR=@@UPLOAD_DIR@@"
# 备份目录：部署工具往里写，应用只读它来报"备份多少份、占多大"（/admin 服务器信息）
Environment="BACKUP_DIR=@@BACKUP_DIR@@"
Environment="CORS_ALLOW_ORIGIN=@@CORS_ALLOW_ORIGIN@@"
Environment="JWT_SECRET=@@JWT_SECRET@@"
Environment="ALLOW_REGISTER=@@ALLOW_REGISTER@@"
Environment="JWT_TTL_SECS=@@JWT_TTL_SECS@@"

[Install]
WantedBy=multi-user.target
