[Unit]
Description=Brainbow Application
After=network.target

[Service]
Type=simple
User=@@REMOTE_USER@@
WorkingDirectory=@@SERVICE_DIR@@
ExecStart=@@SERVICE_DIR@@/brainbow
Restart=on-failure
RestartSec=5
# 优雅关闭超时：SSE/keep-alive 连接可能卡住 graceful shutdown，15 秒后强制终止
TimeoutStopSec=15
MemoryMax=1024M
CPUQuota=80%
Environment="RUST_LOG=info"
# 配置在远端 config/ 下；unit 只负责指路，不再把运行时字段和密钥写进 Environment
Environment="BRAINBOW_CONFIG=@@CONFIG_DIR@@/app.toml"
Environment="BRAINBOW_SECRETS=@@CONFIG_DIR@@/secret.toml"
Environment="BRAINBOW_ROOT=@@REMOTE_DIR@@"

[Install]
WantedBy=multi-user.target
