		"@solidjs/router": "^0.16.3",
		"dompurify": "^3.4.13",
		"highlight.js": "^11.11.1",
		"katex": "^0.18.1",
		"marked": "^18.0.9",
		"marked-highlight": "^2.2.4",
		"marked-katex-extension": "^5.1.10",
		"pdfjs-dist": "5.7.284",
		"solid-icons": "^1.2.0",
		"solid-js": "^1.9.14",
		"three": "^0.186.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.4.0",
		"@types/three": "^0.186.0",
		"jsdom": "^30.0.1",
