{
	"name": "brainbow-web",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.0.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vp dev --mode dev",
		"build": "vp build --mode prod",
		"preview": "vp preview",
		"typecheck": "vp check --no-fmt --no-lint",
		"check": "vp check && stylelint \"src/**/*.css\"",
		"lint": "vp lint --fix && stylelint \"src/**/*.css\" --fix",
		"lint:css": "stylelint \"src/**/*.css\"",
		"fmt": "vp fmt",
		"test": "vp test run",
		"test:watch": "vp test",
		"e2e": "playwright test"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
