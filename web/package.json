	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"jsdom": "^30.0.1",
		"stylelint": "^17.14.1",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "~6.0.3",
		"vite": "^8.2.0",
		"vite-plugin-solid": "^2.11.14",
