{
	"name": "brainbow-web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --mode dev",
		"build": "vite build --mode prod",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"check": "tsc --noEmit && biome check src/ index.html && stylelint \"src/**/*.css\"",
		"lint": "biome check --write src/ index.html && stylelint \"src/**/*.css\" --fix",
		"lint:css": "stylelint \"src/**/*.css\"",
		"fmt": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"ui-inspect": "node scripts/ui-inspect.ts"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/noto-serif-sc": "^5.3.0",
		"@solidjs/router": "^0.16.3",
		"dompurify": "^3.4.13",
		"highlight.js": "^11.11.1",
		"katex": "^0.18.1",
		"marked": "^18.0.9",
		"marked-highlight": "^2.2.4",
		"marked-katex-extension": "^5.1.10",
		"solid-icons": "^1.2.0",
		"solid-js": "^1.9.14"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@types/node": "^26.4.0",
		"jsdom": "^30.0.1",
		"stylelint": "^17.14.1",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "~6.0.3",
		"vite": "8.2.1",
		"vite-plugin-purgecss": "^0.2.13",
		"vite-plugin-solid": "^2.11.14",
		"vitest": "^4.1.10"
	}
}
