{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"types": ["node"],
		"paths": {
			"@/*": ["./src/*"],
			"@app/*": ["./src/app/*"],
			"@domains/*": ["./src/domains/*"],
			"@capabilities/*": ["./src/capabilities/*"],
			"@platform/*": ["./src/platform/*"],
			"@tools/*": ["./src/tools/*"],
			"@modules/bookmark": ["./src/domains/bookmark/index.ts"],
			"@modules/bookmark/*": ["./src/domains/bookmark/*"],
			"@modules/card": ["./src/domains/card/index.ts"],
			"@modules/card/*": ["./src/domains/card/*"],
			"@modules/conv": ["./src/domains/conv/index.ts"],
			"@modules/conv/*": ["./src/domains/conv/*"],
			"@modules/mem": ["./src/domains/mem/index.ts"],
			"@modules/mem/*": ["./src/domains/mem/*"],
			"@modules/ontology": ["./src/domains/ontology/index.ts"],
			"@modules/ontology/*": ["./src/domains/ontology/*"],
			"@modules/reading": ["./src/domains/reading/index.ts"],
			"@modules/reading/*": ["./src/domains/reading/*"],
			"@modules/task": ["./src/domains/task/index.ts"],
			"@modules/task/*": ["./src/domains/task/*"],
			"@modules/text": ["./src/domains/text/index.ts"],
			"@modules/text/*": ["./src/domains/text/*"],
			"@modules/chat": ["./src/capabilities/chat/index.ts"],
			"@modules/chat/*": ["./src/capabilities/chat/*"],
			"@modules/home": ["./src/capabilities/home/index.ts"],
			"@modules/home/*": ["./src/capabilities/home/*"],
			"@modules/quick-capture": ["./src/capabilities/quick-capture/index.ts"],
			"@modules/quick-capture/*": ["./src/capabilities/quick-capture/*"],
			"@modules/search": ["./src/capabilities/search/index.ts"],
			"@modules/search/*": ["./src/capabilities/search/*"],
			"@modules/admin": ["./src/platform/admin/index.ts"],
			"@modules/admin/*": ["./src/platform/admin/*"],
			"@modules/ai-setting": ["./src/platform/ai-setting/index.ts"],
			"@modules/ai-setting/*": ["./src/platform/ai-setting/*"],
			"@modules/auth": ["./src/platform/auth/index.ts"],
			"@modules/auth/*": ["./src/platform/auth/*"],
			"@modules/command-palette": ["./src/platform/command-palette/index.ts"],
			"@modules/command-palette/*": ["./src/platform/command-palette/*"],
			"@modules/db": ["./src/platform/db/index.ts"],
			"@modules/db/*": ["./src/platform/db/*"],
			"@modules/file": ["./src/platform/file/index.ts"],
			"@modules/file/*": ["./src/platform/file/*"],
			"@modules/key": ["./src/platform/key/index.ts"],
			"@modules/key/*": ["./src/platform/key/*"],
			"@modules/color": ["./src/tools/color/index.ts"],
			"@modules/color/*": ["./src/tools/color/*"],
			"@modules/rainbow": ["./src/tools/rainbow/index.ts"],
			"@modules/rainbow/*": ["./src/tools/rainbow/*"],
			"@components": ["./src/components/index.ts"],
			"@components/*": ["./src/components/*"],
			"@shared/*": ["./src/shared/*"],
			"@config/*": ["./src/config/*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"scripts/**/*.ts",
		"e2e/**/*.ts",
		"playwright.config.ts",
		"vitest.setup.ts",
		"vite-env.d.ts"
	]
}
